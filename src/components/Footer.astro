<style>
  footer {
    margin-top: auto;
    padding: 26px 20px 34px;
    text-align: center;
    color: var(--muted);
    font-size: 12px;
  }
  footer a {
    color: var(--accent2);
  }
  footer .socials {
    display: flex;
    justify-content: center;
    gap: 14px;
    margin-bottom: 16px;
  }
  footer .socials a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--surface);
    color: var(--muted);
    transition:
      color 0.2s ease,
      border-color 0.2s ease,
      transform 0.15s ease,
      background-color 0.2s ease;
  }
  footer .socials a:hover {
    color: var(--accent);
    border-color: var(--accent);
    transform: translateY(-2px);
  }
  footer .socials svg {
    width: 18px;
    height: 18px;
  }
</style>
