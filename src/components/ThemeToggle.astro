---
// Cycles dark → light → cyberpunk → dark, same as the main portfolio.
// morph-icon is progressive enhancement: without the web component the
// embedded SVG fallback renders, keeping the hub self-contained.
---

<button
  id="theme-toggle"
  class="theme-toggle"
  type="button"
  aria-label="Theme: dark. Click to cycle."
  aria-pressed="true"
  title="Theme: dark / light / cyberpunk"
  data-icon-dark="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"
  data-icon-light="M12 7a5 5 0 1 0 0 10a5 5 0 1 0 0-10M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"
  data-icon-cyber="M13 2 3 14 12 14 11 22 21 10 12 10 13 2z"
>
  <morph-icon
    icon="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"
    spring="snappy"
    reduced-motion="user"
    size="18"
    aria-hidden="true"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
    </svg>
  </morph-icon>
</button>

<style>
  .theme-toggle {
    position: absolute;
    top: 16px;
    right: 16px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--surface);
    color: var(--muted);
    cursor: pointer;
    transition:
      color 0.2s ease,
      border-color 0.2s ease,
      background-color 0.2s ease;
  }
  .theme-toggle:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
  .theme-toggle morph-icon {
    display: contents;
  }
</style>

<script is:inline>
  // Inline (not bundled) so dist/index.html stays self-contained.
  (function () {
    var html = document.documentElement;
    var toggle = document.getElementById("theme-toggle");
    var themeColorMeta = document.getElementById("theme-color");
    var THEME_COLORS = {
      dark: "#0f2a2b",
      light: "#f4efca",
      cyberpunk: "#0a0a12",
    };
    var ORDER = ["dark", "light", "cyberpunk"];
    var ICON_PATHS = {};
    if (toggle) {
      ICON_PATHS.dark = toggle.dataset.iconDark;
      ICON_PATHS.light = toggle.dataset.iconLight;
      ICON_PATHS.cyberpunk = toggle.dataset.iconCyber;
    }

    function applyTheme(theme) {
      html.setAttribute("data-theme", theme);
      var themeIcon = document.getElementById("theme-icon");
      if (themeIcon && ICON_PATHS[theme]) themeIcon.icon = ICON_PATHS[theme];
      if (themeColorMeta)
        themeColorMeta.setAttribute(
          "content",
          THEME_COLORS[theme] || THEME_COLORS.dark,
        );
      if (toggle) {
        toggle.setAttribute("aria-pressed", String(theme === "dark"));
        toggle.setAttribute(
          "aria-label",
          "Theme: " + theme + ". Click to cycle.",
        );
      }
    }

    function persistTheme(theme) {
      try {
        localStorage.setItem("theme", theme);
      } catch (e) {}
    }

    // Sync icon with already-applied theme
    applyTheme(html.getAttribute("data-theme") || "dark");

    if (toggle) {
      toggle.addEventListener("click", function () {
        var cur = html.getAttribute("data-theme") || "dark";
        var next = ORDER[(ORDER.indexOf(cur) + 1) % ORDER.length];
        applyTheme(next);
        persistTheme(next);
      });
    }

    window
      .matchMedia("(prefers-color-scheme: dark)")
      .addEventListener("change", function (e) {
        try {
          if (localStorage.getItem("theme")) return;
        } catch (err) {
          return;
        }
        applyTheme(e.matches ? "dark" : "light");
      });
  })();
</script>
